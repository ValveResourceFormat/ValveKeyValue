<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <IsTestProject>true</IsTestProject>
    <Product>Valve KeyValue Library - Source Generator Tests</Product>
    <Description>Unit tests for the ValveKeyValue source generator</Description>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../ValveKeyValue/ValveKeyValue.snk</AssemblyOriginatorKeyFile>
    <!-- The analyzer in SuppressorTestCase stands in for the trim analyzer and is only run by the tests, never loaded by the compiler. -->
    <NoWarn>$(NoWarn);RS1036;RS1041;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Snapshots\**" />
    <None Remove="Snapshots\**" />
    <EmbeddedResource Include="Snapshots\*.g.cs" Exclude="Snapshots\*.received.g.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.12" />
    <PackageReference Include="coverlet.msbuild" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.12.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ValveKeyValue\ValveKeyValue.csproj" />
    <ProjectReference Include="..\ValveKeyValue.SourceGenerator\ValveKeyValue.SourceGenerator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
</Project>
