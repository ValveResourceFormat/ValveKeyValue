"test case"
{
	"operating system"		"windows 32-bit" [$WIN32]
	"operating system"		"something else" [!$WIN32]
	"platform"				"windows" [$WIN32||$WIN64]
	"ui type"				"Widescreen Xbox 360" [$X360 && $X360WIDE]
	"ui type"				"Xbox 360" [$X360 && !$X360WIDE]
	"ui size"				"small" [$X360 && (!$GERMAN && !$FRENCH && !$POLISH)]
	"ui size"				"medium" [$X360 && ($GERMAN || $FRENCH)]
	"ui size"				"large" [$X360 && $POLISH]
	"underscore_condition"  "no" [!$SOMETHING_WITH_UNDERSCORE]
	"underscore_condition"  "yes" [$SOMETHING_WITH_UNDERSCORE]
	"bracketed sides"		"windows" [($WIN32) || ($WIN64)]
	"literal true"			"yes" [1]
	"literal false"			"never" [0]
	"literal multi digit"	"yes" [!00 && 10]
	"negated group"			"yes" [!($GERMAN || $FRENCH)]
	"nested brackets"		"yes" [(($WIN32 && (!$X360)))]
	"left associative"		"yes" [$GERMAN && $FRENCH || $POLISH]
	"or before and"			"yes" [$GERMAN || $FRENCH && $POLISH]
	"double negation"		"yes" [!!$WIN32]
	"dollar only"			"never" [$]
	"digit variable"		"yes" [$0]
	"lowercase variable"	"yes" [$win32]
	"literal brackets"		"yes" [(1) && !(0) && !!1]
	"padded condition"		"yes" [ $WIN32 ]
	"tabbed condition"		"yes" [	$X360	&&	$X360WIDE	]
}
