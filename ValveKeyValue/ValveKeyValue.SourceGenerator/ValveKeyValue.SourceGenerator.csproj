<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ships inside the ValveKeyValue package under analyzers/dotnet/cs, so it is not packed on its own and shares the library's version. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <Product>Valve KeyValue Library - Source Generator</Product>
    <Description>Source generator that replaces reflection-based object mapping in ValveKeyValue</Description>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../ValveKeyValue/ValveKeyValue.snk</AssemblyOriginatorKeyFile>
    <!-- RS2008: release tracking only applies to diagnostics of DiagnosticAnalyzers; these are reported by the generator. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
